# ============================================================================
#  .env.example - TEMPLATE. Safe to commit. Contains no real secrets.
#
#  Setup:  cp .env.example .env    then fill in your own values.
#  The .env file you create is git-ignored and never leaves your machine.
# ============================================================================

# ---------------------------------------------------------------------------
#  App
# ---------------------------------------------------------------------------
# Which environment we're in. Changes how the app behaves:
#   local -> pretty coloured logs, helpful errors
#   prod  -> JSON logs for Grafana, generic errors (never leak internals)
LODESTAR_ENV=local

# How chatty the logs are: DEBUG | INFO | WARNING | ERROR
LODESTAR_LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
#  Postgres  (used from P1 onward)
# ---------------------------------------------------------------------------
# NOTE ON HOST - this is the value that changes per machine:
#   localhost   -> running on your laptop, DB in Docker with a published port
#   postgres    -> running INSIDE Docker (containers reach each other by name)
#   <cloud url> -> production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lodestar
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=lodestar

# ---------------------------------------------------------------------------
#  Arriving in later phases - listed so you can see what's coming.
#  Leave commented until we build that part.
# ---------------------------------------------------------------------------

# -- P6: the LLM. Free key from https://console.groq.com
# GROQ_API_KEY=gsk_your_key_here
# LLM_PROVIDER=groq
#
# Two models, chosen by how hard the job is:
#   SMALL -> the digest agent. ~200 calls/day, just summarise one article.
#   LARGE -> the curator agent. 1 call/day, must reason over 20 candidates.
# Using the large one for both would burn the free-tier rate limit on easy work.
# LLM_MODEL_SMALL=openai/gpt-oss-20b
# LLM_MODEL_LARGE=openai/gpt-oss-120b
#
# WHY THESE LIVE HERE AND NOT IN THE CODE:
# Groq deprecated llama-3.3-70b-versatile (announced 2026-06-17). If that
# string had been hardcoded in a .py file we would be editing Python and
# redeploying. Because it is config, it is a one-line change with no rebuild.
# Model IDs change often. Never hardcode one.

# -- P8: Redis, the task queue's message broker
# REDIS_URL=redis://localhost:6379/0

# -- P9: where the Streamlit UI sends its requests
# API_BASE_URL=http://localhost:8000
